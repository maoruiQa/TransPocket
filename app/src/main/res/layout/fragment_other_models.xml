<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:accessibilityPaneTitle="@string/title_other_models">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/title_other_models"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/xtColorAccent"
                android:layout_marginStart="16dp"
                android:accessibilityHeading="true"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:textColor="@color/very_dark_gray"
                android:textSize="14sp"
                android:text="@string/description_other_models_page" />
            <worker8.com.github.radiogroupplus.RadioGroupPlus
                android:id="@+id/other_model_radios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:screenReaderFocusable="true"
                        android:focusable="false">

                        <RadioButton
                            android:id="@+id/radioMozilla"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginEnd="16dp"
                            android:layout_marginBottom="16dp"
                            android:contentDescription="@string/title_model_mozilla"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.0"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.0" />

                        <TextView
                            android:id="@+id/titleMozilla"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="2dp"
                            android:text="@string/title_model_mozilla"
                            android:textColor="@color/very_very_dark_gray"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:focusable="false"
                            app:layout_constraintBottom_toBottomOf="@+id/radioMozilla"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.0"
                            app:layout_constraintStart_toEndOf="@+id/radioMozilla"
                            app:layout_constraintTop_toTopOf="@+id/radioMozilla" />

                        <TextView
                            android:id="@+id/descriptionMozilla"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginEnd="16dp"
                            android:layout_marginBottom="8dp"
                            android:text="@string/description_model_mozilla"
                            android:focusable="false"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.0"
                            app:layout_constraintStart_toEndOf="@+id/radioMozilla"
                            app:layout_constraintTop_toBottomOf="@+id/titleMozilla"
                            app:layout_constraintVertical_bias="0.0" />

                        <ImageView
                            android:id="@+id/arrowMozilla"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginEnd="24dp"
                            android:layout_marginBottom="2dp"
                            android:contentDescription="@string/description_manage_mozilla_button"
                            app:layout_constraintBottom_toBottomOf="@+id/titleMozilla"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="1.0"
                            app:layout_constraintStart_toEndOf="@+id/titleMozilla"
                            app:layout_constraintTop_toTopOf="@+id/titleMozilla"
                            android:src="@drawable/right_arrow_icon"
                            android:tint="@color/very_dark_gray" />

                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <RadioButton
                            android:id="@+id/radioHY"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginEnd="16dp"
                            android:layout_marginBottom="16dp"
                            android:contentDescription="@string/title_model_hy"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.0"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.0" />

                        <nie.translator.rtranslator.tools.gui.ResourceManagerView
                            android:id="@+id/modelHy"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="16dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/radioHY"
                            app:layout_constraintTop_toTopOf="parent"
                            app:modelDescription="@string/description_model_hy"
                            app:modelSize="1790"
                            app:modelTitle="@string/title_model_hy" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <RadioButton
                            android:id="@+id/radioMadlad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginEnd="16dp"
                            android:layout_marginBottom="16dp"
                            android:contentDescription="@string/title_model_madlad"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.0"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.0" />

                        <nie.translator.rtranslator.tools.gui.ResourceManagerView
                            android:id="@+id/modelMadlad"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="16dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/radioMadlad"
                            app:layout_constraintTop_toTopOf="parent"
                            app:modelDescription="@string/description_model_madlad"
                            app:modelSize="1380"
                            app:modelTitle="@string/title_model_madlad" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </LinearLayout>
            </worker8.com.github.radiogroupplus.RadioGroupPlus>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonUseOther"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:padding="14dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="?attr/xtColorPrimary"
                android:elevation="2dp"
                android:stateListAnimator="@null"
                android:text="@string/use_other_model"
                android:textColor="?attr/xtColorOnPrimary" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
