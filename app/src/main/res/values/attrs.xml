<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Palette roles used by layouts/drawables. Custom names keep per-view theme
         overlays (for example android:theme="@style/Theme.MaterialComponents") from
         replacing the activity's palette with Material's default colors. -->
    <attr name="xtColorPrimary" format="color" />
    <attr name="xtColorPrimaryDark" format="color" />
    <attr name="xtColorPrimaryVeryDark" format="color" />
    <attr name="xtColorPrimaryLite" format="color" />
    <attr name="xtColorPrimaryVeryLite" format="color" />
    <attr name="xtColorAccent" format="color" />
    <attr name="xtColorSecondaryVeryLite" format="color" />
    <attr name="xtColorOnPrimary" format="color" />
    <attr name="xtColorIcon" format="color" />
    <attr name="xtColorAction" format="color" />

    <declare-styleable name="ResourceManagerView">
        <attr name="modelTitle" format="string" />
        <attr name="modelDescription" format="string" />
        <attr name="modelSize" format="integer" />
        <attr name="state" format="enum">
            <enum name="empty" value="0" />
            <enum name="paused" value="1" />
            <enum name="downloading" value="2" />
            <enum name="downloaded" value="3" />
        </attr>
    </declare-styleable>

    <declare-styleable name="SegmentProgressBar">
        <attr name="backgroundColor" format="color" />
        <attr name="cornerRadius" format="dimension" />
        <attr name="maxProgress" format="float" />

        <!-- Comma-separated hex colors (e.g., "#ffbfbf,#a2fab3,#6faffc") -->
        <attr name="segmentColors" format="reference" />

        <!-- Comma-separated progress values (e.g., "30,40,20") -->
        <attr name="segmentProgresses" format="reference" />
    </declare-styleable>
</resources>