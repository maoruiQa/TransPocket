    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar" />

    <style name="Theme.App.Starting" parent="Theme.SplashScreen.IconBackground">
        <!-- Set the splash screen background -->
        <item name="windowSplashScreenBackground">@color/golden_primary_very_lite</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/golden_primary_very_lite</item>
        <!-- Set a background behind the splash screen icon. -->
        <item name="windowSplashScreenIconBackgroundColor">@color/accent_white</item>
        <!-- Use windowSplashScreenAnimatedIcon to add a drawable or an animated drawable. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_screen</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_screen</item>
        <!-- Set the theme of the Activity that follows your splash screen. -->
        <item name="postSplashScreenTheme">@style/Theme.Speech</item>
    </style>

    <!-- Platform splash attrs are set again on each palette. A child that only overrides the
         library attr still inherits the parent's resolved android:windowSplashScreenBackground. -->
    <style name="Theme.App.Starting.Bamboo" parent="Theme.App.Starting">
        <item name="windowSplashScreenBackground">@color/bamboo_primary_very_lite</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/bamboo_primary_very_lite</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_screen_bamboo</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_screen_bamboo</item>
        <item name="postSplashScreenTheme">@style/Theme.Speech.Bamboo</item>
    </style>

