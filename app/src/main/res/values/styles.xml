<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Shared theme. Palette-specific themes only override the color items. -->
    <style name="Theme.Speech.Base" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="color">@color/golden_primary</item>
        <item name="colorPrimary">@color/golden_primary</item>
        <item name="colorPrimaryDark">@color/golden_primary_dark</item>
        <item name="colorPrimaryVariant">@color/golden_primary_dark</item>
        <item name="colorAccent">@color/golden_accent</item>
        <item name="colorSecondary">@color/golden_accent</item>
        <item name="colorSecondaryVariant">@color/golden_accent</item>
        <item name="colorOnPrimary">@color/golden_on_primary</item>
        <item name="colorSurface">@color/golden_surface</item>
        <item name="xtColorPrimary">@color/golden_primary</item>
        <item name="xtColorPrimaryDark">@color/golden_primary_dark</item>
        <item name="xtColorPrimaryVeryDark">@color/golden_primary_very_dark</item>
        <item name="xtColorPrimaryLite">@color/golden_primary_lite</item>
        <item name="xtColorPrimaryVeryLite">@color/golden_primary_very_lite</item>
        <!-- Model-row titles are body-size text, so they use the ink, not the icon gold. -->
        <item name="xtColorAccent">@color/autumn_ink</item>
        <item name="xtColorSecondaryVeryLite">@color/golden_secondary_very_lite</item>
        <item name="xtColorOnPrimary">@color/golden_on_primary</item>
        <item name="xtColorIcon">@color/autumn_gold_icon</item>
        <item name="xtColorAction">@color/autumn_gold_bright</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="cardViewStyle">@style/CardView</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
    </style>

    <style name="Theme.Speech" parent="Theme.Speech.Base">
        <!-- White on #D4A62C is under 3:1. Keep this off Base so other palettes stay light-on-accent. -->
        <item name="colorOnSecondary">@color/golden_on_primary</item>
    </style>

