<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--https://developer.android.com/reference/android/speech/tts/TextToSpeech-->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!--<uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>   re-enable this to use USE_EXTERNAL_MEMORY_FOR_RESOURCES  -->

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SEND_DOWNLOAD_COMPLETED_INTENTS" />
    <uses-permission android:name="android.permission.BROADCAST_STICKY" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!--<uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />-->

    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30"/>
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="30"/>

    <!--<uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />-->

    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name="nie.translator.rtranslator.Global"
        tools:replace="android:allowBackup"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:largeHeap="true"
        android:extractNativeLibs="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.Speech"
        android:enableOnBackInvokedCallback="false"
        tools:ignore="GoogleAppIndexingWarning,NewApi">
        <activity
            android:name="nie.translator.rtranslator.LoadingActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@style/Theme.App.Starting" />

        <!-- One real launcher activity per palette. The enabled component decides the home
             screen icon, and its own theme is the cold-start splash. These cannot be
             activity-aliases: the platform copies the target activity theme onto an alias,
             so every cold start used LoadingActivity's golden splash. LoadingActivity itself
             stays without a launcher filter for in-app restarts. -->
        <activity
            android:name=".LauncherGolden"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_golden"
            android:roundIcon="@mipmap/ic_launcher_golden"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.MULTIWINDOW_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Same golden splash and icon. Default-disabled so later switches restore DEFAULT
             instead of forcing the install-time entry off. -->
        <activity
            android:name=".LauncherGoldenAlt"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_golden"
            android:roundIcon="@mipmap/ic_launcher_golden"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.MULTIWINDOW_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LauncherBamboo"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_bamboo"
            android:roundIcon="@mipmap/ic_launcher_bamboo"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@style/Theme.App.Starting.Bamboo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.MULTIWINDOW_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LauncherIndigo"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_indigo"
            android:roundIcon="@mipmap/ic_launcher_indigo"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@style/Theme.App.Starting.Indigo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.MULTIWINDOW_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LauncherSakura"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sakura"
            android:roundIcon="@mipmap/ic_launcher_sakura"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@style/Theme.App.Starting.Sakura">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.MULTIWINDOW_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".LauncherWisteria"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_wisteria"
            android:roundIcon="@mipmap/ic_launcher_wisteria"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@style/Theme.App.Starting.Wisteria">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.MULTIWINDOW_LAUNCHER" />
            </intent-filter>
        </activity>
        <!--configChanges serve a evitare il riavvio dell' activity quando ruota e quindi per evitare che alla rotazione si notifichi con un Toast l' avvio del
        service in background, inoltre così la rotazione sarà più fluida e per ora non abbiamo problemi ne per la rotazione ne per il ridimensionamento quando in finestra-->
        <activity
            android:name="nie.translator.rtranslator.voice_translation.VoiceTranslationActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenLayout|screenSize"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:theme="@style/Theme.Speech" />
        <activity
            android:name="nie.translator.rtranslator.settings.SettingsActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Settings"
            android:label="@string/title_activity_settings" />
        <activity
            android:name="nie.translator.rtranslator.access.AccessActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Speech" />
        <activity android:name="nie.translator.rtranslator.GeneralActivity" />
        <activity android:name="nie.translator.rtranslator.tools.ImageActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Speech"/>
        <activity
            android:name="nie.translator.rtranslator.voice_translation.FullScreenTextActivity"
            android:theme="@style/Theme.MaterialComponents.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <service android:name="nie.translator.rtranslator.voice_translation._conversation_mode._conversation.ConversationService"
            android:foregroundServiceType="dataSync|microphone"/>
        <service android:name="nie.translator.rtranslator.voice_translation._walkie_talkie_mode._walkie_talkie.WalkieTalkieService"
            android:foregroundServiceType="dataSync|microphone"/>
        <service android:name="nie.translator.rtranslator.voice_translation._live_translation._simultaneous.SimultaneousService"
            android:foregroundServiceType="dataSync|microphone"/>
        <service android:name="nie.translator.rtranslator.GeneralService" />
        <service android:name=".downloader.DownloaderService"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.gallery.RTranslator.2.0.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <uses-library
            android:name="com.sec.android.app.multiwindow"
            android:required="false" />

        <receiver
            android:name=".widgets.WalkieTalkieWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_walkie_talkie_info" />
        </receiver>
    </application>
</manifest>